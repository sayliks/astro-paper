---
import type { HTMLAttributes } from "astro/types";
import type { MomentEntry } from "@/utils/getSortedMoments";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  images?: MomentEntry["data"]["images"];
  loading?: "eager" | "lazy";
  priorityFirstImage?: boolean;
} & HTMLAttributes<"ul">;

const {
  images = [],
  loading,
  priorityFirstImage = false,
  class: className,
  ...attrs
} = Astro.props;

const getImageSrc = (src: string) =>
  /^(?:https?:)?\/\//i.test(src) || src.startsWith("data:")
    ? src
    : getAssetPath(src);
---

{
  images.length > 0 && (
    <ul
      class:list={[
        "moment-images",
        `moment-images--count-${Math.min(images.length, 4)}`,
        className,
      ]}
      aria-label="动态图片"
      {...attrs}
    >
      {images.map((image, index) => {
        const priority = priorityFirstImage && index === 0;

        return (
          <li
            class="moment-image"
            style={`--moment-image-width: ${image.width}; --moment-image-height: ${image.height};`}
          >
            <img
              src={getImageSrc(image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading={priority ? undefined : loading}
              fetchpriority={priority ? "high" : undefined}
              decoding="async"
            />
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .moment-images {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0;
    margin-block: 1.1rem 0;
    list-style: none;
  }

  .moment-images--count-1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: min(100%, 34rem);
  }

  .moment-images--count-3 .moment-image:first-child {
    grid-column: 1 / -1;
  }

  .moment-image {
    min-width: 0;
  }

  .moment-image img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-muted);
    border-radius: 0.375rem;
    aspect-ratio: var(--moment-image-width) / var(--moment-image-height);
  }

  @media (min-width: 640px) {
    .moment-images:not(.moment-images--count-1) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
