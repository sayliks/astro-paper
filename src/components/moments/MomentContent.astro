---
import { render } from "astro:content";
import type { MomentEntry } from "@/utils/getSortedMoments";

type Props = {
  moment: MomentEntry;
  class?: string;
};

const { moment, class: className } = Astro.props;
const { Content } = await render(moment);
---

<div class:list={["app-prose moment-content", className]}>
  <Content />
</div>

<style>
  .moment-content {
    max-width: none;
    color: var(--article-body);
    font-size: 0.975rem;
    line-height: 1.78;
    overflow-wrap: anywhere;
  }

  .moment-content :global(:where(p, ul, ol, blockquote, pre, table, figure)) {
    margin-block: 0 1rem;
  }

  .moment-content :global(:where(h2, h3, h4, h5, h6)) {
    margin-block: 1.35rem 0.65rem;
    color: var(--color-foreground);
    font-weight: 700;
    line-height: 1.35;
  }

  .moment-content :global(h2) {
    font-size: 1.18rem;
  }

  .moment-content :global(h3) {
    font-size: 1.08rem;
  }

  .moment-content :global(:where(h4, h5, h6)) {
    font-size: 1rem;
  }

  .moment-content :global(pre) {
    max-width: 100%;
  }

  .moment-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 0;
    border-radius: 0.35rem;
  }

  .moment-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .moment-content :global(p:last-child),
  .moment-content :global(ul:last-child),
  .moment-content :global(ol:last-child),
  .moment-content :global(blockquote:last-child),
  .moment-content :global(pre:last-child),
  .moment-content :global(table:last-child) {
    margin-bottom: 0;
  }

  .moment-content :global(a) {
    color: var(--color-accent);
  }
</style>
