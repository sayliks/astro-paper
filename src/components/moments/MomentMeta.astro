---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/zh-cn";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";
import type { MomentEntry } from "@/utils/getSortedMoments";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  moment: MomentEntry;
  commentsHref?: string;
  class?: string;
};

const { moment, commentsHref, class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const pubDatetime = dayjs(moment.data.pubDatetime)
  .tz(config.site.timezone)
  .locale("zh-cn");
const modDatetime = moment.data.modDatetime
  ? dayjs(moment.data.modDatetime).tz(config.site.timezone).locale("zh-cn")
  : null;
const isModified = modDatetime && modDatetime.valueOf() > pubDatetime.valueOf();
const formattedPubDatetime = pubDatetime.format("YYYY年M月D日 HH:mm");
const formattedModDatetime = modDatetime?.format("YYYY年M月D日 HH:mm");
const modDatetimeIso = modDatetime?.toISOString();
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1",
    className,
  ]}
  aria-label={t.moments.metadataLabel}
>
  <IconCalendar class="inline-block size-5 min-w-5 scale-90" />
  {
    moment.data.pinned && (
      <span class="text-accent text-sm font-medium">{t.moments.pinned}</span>
    )
  }
  {
    moment.data.draft && (
      <span class="text-accent text-sm font-medium">{t.moments.draft}</span>
    )
  }
  <time class="text-sm" datetime={pubDatetime.toISOString()}>
    {formattedPubDatetime}
  </time>
  {
    isModified && formattedModDatetime && modDatetimeIso && (
      <span class="text-sm">
        {t.moments.updatedAt}:{" "}
        <time datetime={modDatetimeIso}>{formattedModDatetime}</time>
      </span>
    )
  }
  {
    moment.data.mood && (
      <span
        class="text-sm"
        aria-label={`${t.moments.moodLabel}: ${moment.data.mood}`}
      >
        {moment.data.mood}
      </span>
    )
  }
  {
    moment.data.location && (
      <span
        class="text-sm"
        aria-label={`${t.moments.locationLabel}: ${moment.data.location}`}
      >
        {moment.data.location}
      </span>
    )
  }
  {
    commentsHref && (
      <a class="hover:text-accent focus-outline text-sm" href={commentsHref}>
        {t.moments.comments}
      </a>
    )
  }
</div>
