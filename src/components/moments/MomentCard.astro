---
import type { MomentEntry } from "@/utils/getSortedMoments";
import MomentContent from "./MomentContent.astro";
import MomentImages from "./MomentImages.astro";
import MomentMeta from "./MomentMeta.astro";

type Props = {
  moment: MomentEntry;
  href: string;
  loadImagesNormally?: boolean;
};

const { moment, href, loadImagesNormally = false } = Astro.props;
const imageLoading = loadImagesNormally ? undefined : "lazy";
---

<article class="moment-card">
  <header>
    <MomentMeta moment={moment} commentsHref={href} />
  </header>
  <MomentContent moment={moment} class="mt-3" />
  <MomentImages
    images={moment.data.images}
    class="mt-4"
    loading={imageLoading}
    priorityFirstImage={loadImagesNormally}
  />
</article>

<style>
  .moment-card {
    min-width: 0;
    padding-block: 1.35rem;
    border-block-start: 1px solid var(--color-border);
  }

  .moment-card:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .moment-card:last-child {
    padding-block-end: 0;
  }
</style>
