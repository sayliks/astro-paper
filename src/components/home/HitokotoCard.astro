<section
  data-hitokoto-card
  class="border-border bg-background text-foreground group hover:border-accent/45 rounded-lg border py-5 transition-colors"
  aria-label="每日一言"
>
  <div class="flex items-start gap-4 px-4 sm:px-5">
    <blockquote class="min-w-0 flex-1">
      <p
        data-hitokoto-text
        class="text-foreground text-base leading-8 sm:text-lg"
        aria-live="polite"
      >
        正在获取一言...
      </p>
    </blockquote>

    <button
      type="button"
      data-hitokoto-refresh
      class="border-border hover:border-accent hover:bg-muted text-muted-foreground hover:text-foreground grid size-9 shrink-0 place-items-center rounded-md border transition-colors disabled:cursor-wait disabled:opacity-60"
      aria-label="刷新一言"
    >
      <span aria-hidden="true">↻</span>
    </button>
  </div>

  <div
    class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 px-4 text-sm sm:px-5"
  >
    <p data-hitokoto-author></p>
    <p data-hitokoto-source></p>
    <a
      data-hitokoto-link
      href="https://hitokoto.cn/"
      target="_blank"
      rel="noreferrer"
      class="hover:text-accent underline decoration-dashed underline-offset-4 transition-colors"
      hidden
    >
      详情
    </a>
  </div>

  <p data-hitokoto-error class="sr-only" aria-live="polite"></p>
</section>

<script>
  type HitokotoResponse = {
    id: number;
    uuid: string;
    hitokoto: string;
    type: string;
    from: string;
    from_who: string | null;
    creator: string;
    creator_uid: number;
    reviewer: number;
    commit_from: string;
    created_at: string;
    length: number;
  };

  const HITOKOTO_API =
    "https://v1.hitokoto.cn/?c=d&c=e&c=k&max_length=42&encode=json";
  const FALLBACK_QUOTE: HitokotoResponse = {
    id: 0,
    uuid: "",
    hitokoto: "慢慢来，认真走，今天也会有一点新的光。",
    type: "e",
    from: "sayliks corner",
    from_who: null,
    creator: "sayliks",
    creator_uid: 0,
    reviewer: 0,
    commit_from: "fallback",
    created_at: "",
    length: 20,
  };

  function formatSource(data: HitokotoResponse): string {
    if (data.from) return data.from;
    return "一言";
  }

  function formatAuthor(data: HitokotoResponse): string {
    return data.from_who || data.creator || "佚名";
  }

  function applyQuote(card: HTMLElement, data: HitokotoResponse): void {
    const text = card.querySelector<HTMLElement>("[data-hitokoto-text]");
    const author = card.querySelector<HTMLElement>("[data-hitokoto-author]");
    const source = card.querySelector<HTMLElement>("[data-hitokoto-source]");
    const link = card.querySelector<HTMLAnchorElement>("[data-hitokoto-link]");

    if (text) text.textContent = `“${data.hitokoto}”`;
    if (author) author.textContent = `作者：${formatAuthor(data)}`;
    if (source) source.textContent = `出处：${formatSource(data)}`;

    if (link) {
      if (data.uuid) {
        link.href = `https://hitokoto.cn/?uuid=${encodeURIComponent(data.uuid)}`;
        link.hidden = false;
      } else {
        link.hidden = true;
      }
    }
  }

  async function fetchQuote(card: HTMLElement): Promise<void> {
    const refresh = card.querySelector<HTMLButtonElement>(
      "[data-hitokoto-refresh]"
    );
    const text = card.querySelector<HTMLElement>("[data-hitokoto-text]");
    const error = card.querySelector<HTMLElement>("[data-hitokoto-error]");

    if (refresh) refresh.disabled = true;
    if (text) text.textContent = "正在获取一言...";
    if (error) error.textContent = "";

    try {
      const response = await fetch(HITOKOTO_API, { cache: "no-store" });
      if (!response.ok) throw new Error("Hitokoto request failed");
      const data = (await response.json()) as HitokotoResponse;
      applyQuote(card, data);
    } catch {
      applyQuote(card, FALLBACK_QUOTE);
      if (error) {
        error.textContent = "一言获取失败，已显示备用句子。";
      }
    } finally {
      if (refresh) refresh.disabled = false;
    }
  }

  function setupHitokotoCards(): void {
    document
      .querySelectorAll<HTMLElement>("[data-hitokoto-card]")
      .forEach(card => {
        if (card.dataset.hitokotoReady === "true") return;
        card.dataset.hitokotoReady = "true";

        card
          .querySelector<HTMLButtonElement>("[data-hitokoto-refresh]")
          ?.addEventListener("click", () => fetchQuote(card));

        fetchQuote(card);
      });
  }

  setupHitokotoCards();
  document.addEventListener("astro:page-load", setupHitokotoCards);
</script>
