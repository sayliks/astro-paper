---
import type { HTMLAttributes } from "astro/types";
import IconRss from "@/assets/icons/IconRss.svg";
import IconGithub from "@/assets/icons/socials/github.svg";
import IconX from "@/assets/icons/socials/x.svg";
import IconDiscord from "@/assets/icons/socials/discord.svg";
import IconMail from "@/assets/icons/socials/mail.svg";
import LinkButton from "./LinkButton.astro";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, style, ...attrs } = Astro.props;

const rssHref = getAssetPath("rss.xml");

const footerStyle = [style].filter(Boolean).join("; ") || undefined;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  style={footerStyle}
  {...attrs}
>
  <div
    class="border-border flex items-center justify-center border-t py-6 sm:py-4"
  >
    <div class="flex flex-wrap items-center justify-center gap-1" aria-label="联系方式">
      <LinkButton
        href="https://github.com/sayliks"
        class="p-1.5 hover:rotate-6 sm:p-1"
        title="GitHub 上的 sayliks"
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconGithub
          class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
        />
        <span class="sr-only">GitHub 上的 sayliks</span>
      </LinkButton>
      <LinkButton
        href="https://x.com/frsayliks"
        class="p-1.5 hover:rotate-6 sm:p-1"
        title="X 上的 sayliks"
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconX
          class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
        />
        <span class="sr-only">X 上的 sayliks</span>
      </LinkButton>
      <LinkButton
        href="https://discord.gg/5khVRKUv"
        class="p-1.5 hover:rotate-6 sm:p-1"
        title="Discord 上的 saylikx"
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconDiscord
          class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
        />
        <span class="sr-only">Discord 上的 saylikx</span>
      </LinkButton>
      <LinkButton
        href="mailto:sayliks@outlook.com"
        class="p-1.5 hover:rotate-6 sm:p-1"
        title="给 sayliks 发邮件"
      >
        <IconMail
          class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
        />
        <span class="sr-only">给 sayliks 发邮件</span>
      </LinkButton>
      <LinkButton
        href={rssHref}
        class="p-1.5 hover:rotate-6 sm:p-1"
        title="订阅 RSS"
      >
        <IconRss
          class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
        />
        <span class="sr-only">订阅 RSS</span>
      </LinkButton>
    </div>
  </div>
</footer>
