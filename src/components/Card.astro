---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  staggerIndex?: number;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  staggerIndex,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, tags, ogImage, ...props } = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li
  class="card-grid-item fade-in-up"
  style={staggerIndex !== undefined ? `--i: ${staggerIndex}` : undefined}
>
  <article class="card-grid-card">
    {
      ogImage && (
        <a href={postUrl} class="card-grid-img-link" tabindex="-1">
          {typeof ogImage === "string" ? (
            <img src={ogImage} alt="" loading="lazy" decoding="async" />
          ) : (
            <Image
              src={ogImage}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 640px) 400px, 100%"
              loading="lazy"
              decoding="async"
            />
          )}
        </a>
      )
    }
    <div class="card-grid-body">
      <a
        href={postUrl}
        class:list={[
          "text-accent inline-block font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          class="text-lg leading-snug"
          transition:name={toTransitionName(title)}
        >
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
      <p class="flex-1">{description}</p>
      <div class="card-grid-tags">
        {tags.map(tag => <span class="card-grid-tag">{tag}</span>)}
      </div>
    </div>
  </article>
</li>
