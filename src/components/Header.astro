---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconDeviceDesktop from "@/assets/icons/IconDeviceDesktop.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    class="border-border bg-background relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute py-1 font-serif text-xl leading-8 font-bold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
      style="font-family: 'CMU Serif', 'Latin Modern Roman', 'Computer Modern Serif', Georgia, 'Times New Roman', serif; letter-spacing: 0.05em;"
    >
      {site.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent mt-4 grid max-h-0 w-56 grid-cols-2 place-content-center gap-2 overflow-hidden opacity-0 transition-all duration-250 ease-in-out sm:mt-0 sm:flex sm:max-h-none sm:w-auto sm:gap-x-2 sm:gap-y-0 sm:opacity-100 md:gap-x-4 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-bold sm:[&>li>a]:px-1.5 sm:[&>li>a]:py-1 md:[&>li>a]:px-2"
      >
        <li class="col-span-2 sm:order-1">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "relative",
              { "text-accent font-bold": isActive("/posts") },
            ]}
          >
            {t.nav.posts}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="col-span-2 sm:order-4">
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "relative",
                  { "text-accent font-bold": isActive("/archives") },
                ]}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        <li class="col-span-2 sm:order-3">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "relative",
              { "text-accent font-bold": isActive("/about") },
            ]}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.search !== false && (
            <li class="col-span-1 mt-2 flex items-center justify-center sm:order-5 sm:mt-0">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={[
                  "focus-outline relative size-11 sm:size-8",
                  { "text-accent": isActive("/search") },
                ]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 mt-2 flex items-center justify-center sm:order-6 sm:mt-0">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-accent relative size-11 p-3 sm:size-8 sm:p-2"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
                aria-live="polite"
                data-label-toggle={t.a11y.toggleTheme}
                data-label-current={t.a11y.themeCurrent}
                data-label-system={t.a11y.themeSystem}
                data-label-light={t.a11y.themeLight}
                data-label-dark={t.a11y.themeDark}
              >
                <IconDeviceDesktop
                  data-theme-icon="system"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
                <IconSunHigh
                  data-theme-icon="light"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
                <IconMoon
                  data-theme-icon="dark"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
