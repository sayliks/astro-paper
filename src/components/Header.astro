---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconStar from "@/assets/icons/IconStar.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconDeviceDesktop from "@/assets/icons/IconDeviceDesktop.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="flex flex-col items-center justify-between sm:flex-row"
  style="background: rgba(255,255,255,0.02); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.06);"
>
  <div
    class="app-layout relative flex w-full items-center justify-between py-4 sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-foreground hover:text-accent flex size-10 items-center justify-center rounded-full transition-colors"
      aria-label={site.title}
      title={site.title}
    >
      <IconStar class="size-6" aria-hidden="true" />
    </a>

    <!-- Desktop nav: inline links -->
    <nav class="hidden sm:flex sm:items-center sm:gap-x-2 sm:gap-y-0 md:gap-x-4">
      <a href={getRelativeLocaleUrl(locale, "posts")} class:list={["py-1 text-base font-bold", { "text-accent": isActive("/posts") }]}>{t.nav.posts}</a>
      {features.showArchives && <a href={getRelativeLocaleUrl(locale, "archives")} class:list={["py-1 text-base font-bold", { "text-accent": isActive("/archives") }]}>{t.nav.archives}</a>}
      {features.search !== false && <a href={getRelativeLocaleUrl(locale, "search")} class:list={["py-1 text-base font-bold", { "text-accent": isActive("/search") }]}>{t.nav.search}</a>}
      <a href={getRelativeLocaleUrl(locale, "about")} class:list={["py-1 text-base font-bold", { "text-accent": isActive("/about") }]}>{t.nav.about}</a>
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="hover:[&>svg]:stroke-accent relative size-8 p-2"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
            aria-live="polite"
            data-label-toggle={t.a11y.toggleTheme}
            data-label-current={t.a11y.themeCurrent}
            data-label-system={t.a11y.themeSystem}
            data-label-light={t.a11y.themeLight}
            data-label-dark={t.a11y.themeDark}
          >
            <IconDeviceDesktop data-theme-icon="system" class="absolute top-1/2 left-1/2 size-6" aria-hidden="true" />
            <IconSunHigh data-theme-icon="light" class="absolute top-1/2 left-1/2 size-6" aria-hidden="true" />
            <IconMoon data-theme-icon="dark" class="absolute top-1/2 left-1/2 size-6" aria-hidden="true" />
          </button>
        )
      }
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="flex items-center justify-center p-2 sm:hidden"
      style="min-width:44px;min-height:44px"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu-overlay"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconMenuDeep id="menu-icon" class="size-6" />
    </button>
  </div>
</header>

<!-- Mobile overlay: separate element, simple hidden toggle -->
<div id="mobile-menu-overlay" class="fixed inset-0 z-[9999] hidden flex-col items-center justify-center gap-8 bg-background/95 backdrop-blur-xl">
  <button id="mobile-menu-close" class="absolute right-6 top-6 p-2" aria-label={t.a11y.closeMenu}>
    <IconX class="size-8" />
  </button>
  <a href={getRelativeLocaleUrl(locale, "posts")} class="mobile-nav-link text-3xl font-semibold">{t.nav.posts}</a>
  {features.showArchives && <a href={getRelativeLocaleUrl(locale, "archives")} class="mobile-nav-link text-3xl font-semibold">{t.nav.archives}</a>}
  {features.search !== false && <a href={getRelativeLocaleUrl(locale, "search")} class="mobile-nav-link text-3xl font-semibold">{t.nav.search}</a>}
  <a href={getRelativeLocaleUrl(locale, "about")} class="mobile-nav-link text-3xl font-semibold">{t.nav.about}</a>
</div>

<style>
  .mobile-nav-link {
    transition: color 0.15s ease;
  }
  .mobile-nav-link:hover {
    color: #7cc7ff;
  }
</style>
