---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconDeviceDesktop from "@/assets/icons/IconDeviceDesktop.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="flex flex-col items-center justify-between sm:flex-row"
  style="background: rgba(255,255,255,0.02); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.06);"
>
  <div
    class="app-layout relative flex w-full items-center justify-between py-4 sm:py-6"
  >
    <div class="flex flex-nowrap items-baseline gap-0 whitespace-nowrap">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="py-1 text-xl leading-8 whitespace-nowrap sm:text-2xl sm:leading-none"
        style="font-family: var(--font-app); letter-spacing: 0.02em;"
      >
        {site.title}
      </a>
      <span class="ms-2 text-lg font-normal tracking-normal opacity-70 sm:text-xl" style="font-family: 'KaiTi', 'STKaiti', 'Kaiti SC', serif;">
        for <input type="text" placeholder="token" id="token-input" class="inline-block w-32 border-b border-current bg-transparent px-1 text-lg font-normal tracking-normal text-center outline-none sm:text-xl" style="font-family: ui-monospace, 'Cascadia Code', Consolas, 'Source Code Pro', monospace;" />
      </span>
    </div>
    <nav
      id="nav-menu"
      class="flex items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="flex items-center justify-center p-2 sm:hidden"
        style="min-width:44px;min-height:44px"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent nav-link-font mt-4 grid max-h-0 w-56 grid-cols-2 place-content-center gap-2 overflow-hidden opacity-0 transition-all duration-250 ease-in-out sm:mt-0 sm:flex sm:max-h-none sm:w-auto sm:gap-x-2 sm:gap-y-0 sm:opacity-100 md:gap-x-4 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-bold sm:[&>li>a]:px-1.5 sm:[&>li>a]:py-1 md:[&>li>a]:px-2"
      >
        <li class="col-span-2 sm:order-1">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "relative",
              { "text-accent font-bold": isActive("/posts") },
            ]}
          >
            {t.nav.posts}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="col-span-2 sm:order-2">
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "relative",
                  { "text-accent font-bold": isActive("/archives") },
                ]}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-2 sm:order-3">
              <a
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={[
                  "relative",
                  { "text-accent font-bold": isActive("/search") },
                ]}
              >
                {t.nav.search}
              </a>
            </li>
          )
        }
        <li class="col-span-2 sm:order-4">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "relative",
              { "text-accent font-bold": isActive("/about") },
            ]}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 mt-2 hidden items-center justify-center sm:order-6 sm:mt-0 sm:flex">
              <button
                id="theme-btn"
                class="hover:[&>svg]:stroke-accent relative size-11 p-3 sm:size-8 sm:p-2"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
                aria-live="polite"
                data-label-toggle={t.a11y.toggleTheme}
                data-label-current={t.a11y.themeCurrent}
                data-label-system={t.a11y.themeSystem}
                data-label-light={t.a11y.themeLight}
                data-label-dark={t.a11y.themeDark}
              >
                <IconDeviceDesktop
                  data-theme-icon="system"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
                <IconSunHigh
                  data-theme-icon="light"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
                <IconMoon
                  data-theme-icon="dark"
                  class="absolute top-1/2 left-1/2 size-6"
                  aria-hidden="true"
                />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const input = document.getElementById("token-input");
  if (input) {
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = input.value.trim().toLowerCase();
        if (val === "photo wall" || val === "photo") {
          window.location.href = "/photo-wall";
        } else if (val === "about") {
          window.location.href = "/about";
        }
      }
    });
  }
</script>
