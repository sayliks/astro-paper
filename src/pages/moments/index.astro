---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import MomentCard from "@/components/moments/MomentCard.astro";
import { useTranslations } from "@/i18n";
import { getPublishedSortedMoments } from "@/utils/contentQueries";
import { getMomentUrl } from "@/utils/getSortedMoments";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const moments = await getPublishedSortedMoments();
const momentsRssHref = new URL(getAssetPath("moments/rss.xml"), Astro.site);
---

<Layout
  title={`${t.pages.momentsTitle} | ${config.site.title}`}
  description={t.pages.momentsDesc}
  speedInsights={false}
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.moments.rssTitle}
      href={momentsRssHref}
    />
  </Fragment>

  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.momentsTitle} pageDesc={t.pages.momentsDesc}>
    {
      moments.length > 0 ? (
        <section class="mt-2" aria-label={t.moments.title} data-pagefind-ignore>
          {moments.map((moment, index) => (
            <MomentCard
              moment={moment}
              href={getMomentUrl(moment, locale)}
              loadImagesNormally={index === 0}
            />
          ))}
        </section>
      ) : (
        <p class="text-muted-foreground border-border border-t border-dashed py-6">
          {t.moments.empty}
        </p>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  import "@/scripts/image-fade";
</script>
