---
import { type CollectionEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Giscus from "@/components/Giscus.astro";
import LinkButton from "@/components/LinkButton.astro";
import MomentContent from "@/components/moments/MomentContent.astro";
import MomentImages from "@/components/moments/MomentImages.astro";
import MomentMeta from "@/components/moments/MomentMeta.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n";
import { getPublishedSortedMoments } from "@/utils/contentQueries";
import {
  getMomentDescription,
  getMomentMetaTitle,
  getMomentSlug,
  getMomentUrl,
} from "@/utils/getSortedMoments";
import config from "@/config";

export async function getStaticPaths() {
  const moments = await getPublishedSortedMoments();

  return moments.map(moment => ({
    params: { slug: getMomentSlug(moment) },
    props: { moment },
  }));
}

type Props = {
  moment: CollectionEntry<"moments">;
};

const { moment } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { headings } = await render(moment);
const renderedHtml = moment.rendered?.html ?? "";
const hasLinkableHeadings = headings.some(
  ({ depth }) => depth >= 2 && depth <= 6
);
const hasCodeBlocks = renderedHtml.includes("<pre");
const title = getMomentMetaTitle(moment);
const description = getMomentDescription(moment);
const canonicalURL = new URL(getMomentUrl(moment, locale), Astro.site).href;
const backHref = getRelativeLocaleUrl(locale, "moments");
const ogImage = moment.data.images[0]?.src;
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  ogType="article"
  speedInsights={false}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={moment.data.pubDatetime.toISOString()}
    />
    {
      moment.data.modDatetime && (
        <meta
          property="article:modified_time"
          content={moment.data.modDatetime.toISOString()}
        />
      )
    }
  </Fragment>

  <Header />

  <main id="main-content" class="app-layout bg-giscus-surface pt-8">
    <LinkButton
      href={backHref}
      class="text-muted-foreground hover:text-foreground -ms-1 mb-6 inline-flex items-center gap-1.5"
    >
      <IconChevronLeft class="inline-block size-5 rtl:rotate-180" />
      <span>{t.moments.backToMoments}</span>
    </LinkButton>

    <article id="article" data-pagefind-body class="mx-auto max-w-[43.25rem]">
      <header class="mb-6">
        <p class="text-accent mb-2 text-sm font-medium tracking-normal">
          {t.moments.title}
        </p>
        <h1
          class="text-2xl leading-snug font-semibold sm:text-3xl sm:leading-tight"
        >
          {title}
        </h1>
        <MomentMeta moment={moment} class="mt-3" />
      </header>

      <MomentContent moment={moment} />
      <MomentImages
        images={moment.data.images}
        class="mt-5"
        loading="lazy"
        priorityFirstImage
      />
    </article>

    <Giscus />
  </main>

  <Footer />
</Layout>

{hasLinkableHeadings && <script>import "@/scripts/heading-links";</script>}

{hasCodeBlocks && <script>import "@/scripts/code-copy";</script>}

<script>
  import "@/scripts/image-fade";
</script>
