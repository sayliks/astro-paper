---
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/zh-cn";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPublishedSortedPosts } from "@/utils/contentQueries";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getPublishedSortedPosts();
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getPostsByGroupCondition(posts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <section class="archive-year">
            <h2 class="archive-year-heading">
              {year}
              <sup class="text-muted-foreground text-sm font-normal">{yearGroup.length}</sup>
            </h2>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="archive-month">
                  <h3 class="archive-month-heading">
                    {monthFormatter.format(
                      new Date(2000, Number(month) - 1, 1)
                    )}
                    <sup class="text-muted-foreground text-xs font-normal">{monthGroup.length}</sup>
                  </h3>
                  <ul class="archive-list">
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => {
                        const postDate = dayjs(data.data.pubDatetime)
                          .tz(config.site.timezone)
                          .locale("zh-cn")
                          .format("M月D日");
                        const postUrl = getPostUrl(data.id, data.filePath, locale);
                        return (
                          <li class="archive-item fade-in-up">
                            <time
                              class="archive-date"
                              datetime={new Date(data.data.pubDatetime).toISOString()}
                            >
                              {postDate}
                            </time>
                            <a href={postUrl} class="archive-link">
                              {data.data.title}
                            </a>
                          </li>
                        );
                      })}
                  </ul>
                </div>
              ))}
          </section>
        ))
    }
  </Main>

  <Footer />
</Layout>

<script>
  import "@/scripts/reveal";
</script>

<style>
  .archive-year {
    margin-bottom: 2.5rem;
  }

  .archive-year-heading {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .archive-month {
    margin-top: 1.5rem;
  }

  .archive-month-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .archive-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .archive-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .archive-item:last-child {
    border-bottom: 0;
  }

  .archive-date {
    flex-shrink: 0;
    min-width: 4.5rem;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-link {
    color: var(--color-accent);
    text-decoration: dashed;
    text-underline-offset: 4px;
    font-size: 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .archive-link:hover {
    text-decoration: underline;
  }
</style>
