---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const title = `${t.notFound.title} | ${config.site.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const homeHref = getRelativeLocaleUrl(locale, "");
---

<!doctype html>
<html dir={config.site.dir ?? "ltr"} lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={config.site.description} />
    <style is:inline>
      :root {
        color-scheme: light dark;
        --not-found-bg: #f7f4ef;
        --not-found-text: #2f3339;
        --not-found-muted: #636a73;
        --not-found-accent: #e07030;
        --not-found-ring: rgba(224, 112, 48, 0.28);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --not-found-bg: #151a20;
          --not-found-text: #f0f2f5;
          --not-found-muted: #b9c0cb;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100svh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: var(--not-found-bg);
        color: var(--not-found-text);
        font-family:
          ui-monospace, SFMono-Regular, "SF Mono", Consolas, "Liberation Mono",
          Menlo, monospace;
        line-height: 1.6;
      }

      main {
        width: min(100%, 36rem);
        text-align: center;
      }

      .site {
        margin: 0 0 1rem;
        color: var(--not-found-muted);
        font-size: 0.875rem;
        letter-spacing: 0;
      }

      h1 {
        margin: 0;
        color: var(--not-found-accent);
        font-size: clamp(5rem, 28vw, 8rem);
        line-height: 1;
      }

      .shrug {
        margin: 0.5rem 0 0;
        color: var(--not-found-muted);
      }

      p {
        margin: 1.25rem auto 0;
        max-width: 28rem;
        font-size: clamp(1.1rem, 4vw, 1.45rem);
      }

      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        margin-top: 1.75rem;
        border: 1px solid currentColor;
        border-radius: 0.5rem;
        padding: 0.65rem 1rem;
        color: var(--not-found-accent);
        text-decoration: none;
        text-underline-offset: 0.25rem;
      }

      a:focus-visible {
        outline: 3px solid var(--not-found-ring);
        outline-offset: 3px;
      }

      a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main id="main-content">
      <p class="site">{config.site.title}</p>
      <h1>404</h1>
      <p class="shrug" aria-hidden="true">¯\_(ツ)_/¯</p>
      <p>{t.notFound.message}</p>
      <a href={homeHref}>{t.notFound.goHome}</a>
    </main>
  </body>
</html>
