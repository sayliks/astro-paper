---
import LinkButton from "@/components/LinkButton.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

type Props = {
  title: string;
  description: string;
};

const { title: postTitle, description } = Astro.props;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(postTitle);

const platformLabels: Record<string, string> = {
  wechat: "微信",
  weibo: "微博",
  telegram: "Telegram",
  mail: "邮件",
  copy: "链接",
};

const platformLabel = (name: string) => platformLabels[name] ?? name;

const getShareHref = (name: string, baseUrl: string) => {
  switch (name) {
    case "weibo":
      return `${baseUrl}?url=${encodedUrl}&title=${encodedTitle}`;
    case "telegram":
      return `${baseUrl}?url=${encodedUrl}&text=${encodedTitle}`;
    case "mail": {
      const body = encodeURIComponent(
        `${postTitle}\n\n${description}\n\n${pageUrl}`
      );
      return `${baseUrl}?subject=${encodedTitle}&body=${body}`;
    }
    default:
      return `${baseUrl}${encodedUrl}`;
  }
};

const iconClass =
  "inline-block size-6 scale-110 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent";
const shareControlClass =
  "group inline-flex size-11 items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:text-accent";

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));
    const action =
      name === "wechat" || name === "copy" ? (name as "wechat" | "copy") : null;
    const href = action ? null : getShareHref(name, url);
    return { action, href, name, title, Icon };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div
      class="share-root relative flex flex-none flex-col items-center justify-center gap-1 md:items-start"
      data-share-root
      data-share-url={pageUrl}
    >
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="flex flex-wrap items-center justify-center gap-1 text-center">
        {items.map(({ action, href, name, title, Icon }) => {
          if (!Icon) return null;

          return action ? (
            <button
              type="button"
              class={shareControlClass}
              title={title}
              aria-label={title}
              aria-expanded={name === "wechat" ? "false" : undefined}
              data-share-action={action}
            >
              <Icon class={iconClass} />
              <span class="sr-only" data-share-button-label>
                {title}
              </span>
            </button>
          ) : (
            <LinkButton
              href={href ?? "#"}
              class={shareControlClass}
              title={title}
              target={name === "mail" ? undefined : "_blank"}
              rel={name === "mail" ? undefined : "noopener noreferrer"}
            >
              <Icon class={iconClass} />
              <span class="sr-only">{title}</span>
            </LinkButton>
          );
        })}
      </div>

      <span
        class="text-accent mt-1 min-h-5 text-xs opacity-0 transition-opacity"
        aria-live="polite"
        data-share-feedback
      />

      <div
        class="border-border bg-background text-foreground absolute bottom-full left-1/2 z-20 mb-3 hidden w-64 -translate-x-1/2 rounded-md border p-3 text-left text-sm shadow-lg md:left-0 md:translate-x-0"
        role="status"
        data-wechat-popover
      >
        <div class="mb-2 flex items-center justify-between gap-3">
          <strong class="text-sm">微信分享</strong>
          <button
            type="button"
            class="text-muted-foreground hover:text-accent rounded px-1"
            aria-label="关闭微信分享提示"
            data-wechat-close
          >
            ×
          </button>
        </div>
        <p>已复制链接，可粘贴到微信分享。</p>
        <p class="text-muted-foreground mt-1 text-xs">
          使用微信扫码分享：当前版本先使用复制链接作为轻量回退。
        </p>
      </div>
    </div>
  )
}

<script>
  import "@/scripts/share-actions";
</script>
