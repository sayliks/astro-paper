---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import HitokotoCard from "@/components/home/HitokotoCard.astro";
import MomentMeta from "@/components/moments/MomentMeta.astro";
import {
  getMomentDescription,
  getMomentMetaTitle,
  getMomentUrl,
  getSortedMoments,
} from "@/utils/getSortedMoments";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const moments = getSortedMoments(await getCollection("moments"));
const homePath = getRelativeLocaleUrl(locale, "");

type RecentFeedItem =
  | {
      type: "post";
      sortTime: number;
      post: CollectionEntry<"posts">;
    }
  | {
      type: "moment";
      sortTime: number;
      moment: CollectionEntry<"moments">;
    };

const getSortTime = (date: Date | string | null | undefined) =>
  date ? new Date(date).getTime() : 0;

const recentFeedItems: RecentFeedItem[] = [
  ...recentPosts.map(post => ({
    type: "post" as const,
    sortTime: getSortTime(post.data.modDatetime ?? post.data.pubDatetime),
    post,
  })),
  ...moments.map(moment => ({
    type: "moment" as const,
    sortTime: getSortTime(moment.data.modDatetime ?? moment.data.pubDatetime),
    moment,
  })),
]
  .sort((a, b) => b.sortTime - a.sortTime)
  .slice(0, postsConfig.perIndex);
---

<Layout clientRouter={false} preloadFont={false}>
  <Header />
  <main id="main-content" data-back-url={homePath} class="app-layout">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <HitokotoCard />
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentFeedItems.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentFeedItems.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentFeedItems.map(item =>
              item.type === "post" ? (
                <Card variant="h3" {...item.post} />
              ) : (
                <li class="my-6">
                  <a
                    href={getMomentUrl(item.moment, locale)}
                    class:list={[
                      "text-accent inline-block text-lg font-medium",
                      "decoration-dashed underline-offset-4 hover:underline",
                      "focus-visible:no-underline focus-visible:underline-offset-0",
                    ]}
                  >
                    <h3>{getMomentMetaTitle(item.moment)}</h3>
                  </a>
                  <MomentMeta moment={item.moment} class="mt-1" />
                  <p>{getMomentDescription(item.moment, 96)}</p>
                </li>
              )
            )}
          </ul>
        </section>
      )
    }

    <div
      class="my-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-center"
    >
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        {t.pages.postsTitle}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "moments")}>
        {t.home.allPosts}
        {t.pages.momentsTitle}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
