---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import HitokotoCard from "@/components/home/HitokotoCard.astro";
import MomentGridCard from "@/components/moments/MomentGridCard.astro";
import {
  getPublishedSortedMoments,
  getPublishedSortedPosts,
} from "@/utils/contentQueries";
import { getRecentFeedItems } from "@/utils/recentFeed";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getPublishedSortedPosts();
const featuredPosts = posts.filter(({ data }) => data.featured);
const moments = await getPublishedSortedMoments();
const homePath = getRelativeLocaleUrl(locale, "");
const recentLimit = postsConfig.perIndex;
const recentFeedItems = getRecentFeedItems({
  posts,
  moments,
  limit: recentLimit,
});
---

<Layout clientRouter={false} preloadFont={false}>
  <Header />
  <main id="main-content" data-back-url={homePath} class="app-layout">
    <section id="hero" class="reveal-section pt-2 pb-2">
      <HitokotoCard />
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "reveal-section pt-12 pb-6",
            { "border-border border-b": recentFeedItems.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul class="card-grid">
            {featuredPosts.map((data, index) => (
              <Card variant="h3" staggerIndex={index} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentFeedItems.length > 0 && (
        <section id="recent-posts" class="reveal-section pt-2 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul class="card-grid">
            {recentFeedItems.map((item, index) =>
              item.type === "post" ? (
                <Card variant="h3" staggerIndex={index} {...item.post} />
              ) : (
                <MomentGridCard moment={item.moment} staggerIndex={index} />
              )
            )}
          </ul>
        </section>
      )
    }

    <div
      class="my-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-center"
    >
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        {t.pages.postsTitle}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "moments")}>
        {t.home.allPosts}
        {t.pages.momentsTitle}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/reveal";
  import "@/scripts/image-fade";
</script>
