---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const contentAreas = [
  {
    label: "随笔",
    description: "长文、标签、摘要、发布时间与分享图片。",
    href: "https://github.com/sayliks/astro-paper/tree/main/src/content/posts",
    path: "src/content/posts",
  },
  {
    label: "动态",
    description: "轻量状态、心情、地点与配图。",
    href: "https://github.com/sayliks/astro-paper/tree/main/src/content/moments",
    path: "src/content/moments",
  },
  {
    label: "照片墙",
    description: "六张展示照片、替代文本、尺寸与排序。",
    href: "https://github.com/sayliks/astro-paper/blob/main/src/data/photoWall.json",
    path: "src/data/photoWall.json",
  },
];
---

<Layout
  title={`内容管理 | ${config.site.title}`}
  description="通过 Sveltia CMS 或 GitHub 管理随笔、动态和照片墙内容。"
>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <section aria-labelledby="cms-title" class="space-y-5">
      <div>
        <p class="text-muted-foreground text-sm font-semibold">CMS</p>
        <h1 id="cms-title" class="mt-2 text-2xl font-semibold sm:text-3xl">
          内容管理
        </h1>
      </div>

      <p class="text-muted-foreground max-w-2xl">
        使用 Sveltia CMS
        编辑随笔、动态和照片墙；需要更细的文件操作时，可以直接前往 GitHub。
      </p>

      <div class="flex flex-wrap gap-x-5 gap-y-3">
        <a
          href="/cms/index.html"
          class="text-accent rounded-sm font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
        >
          打开 Sveltia CMS &rarr;
        </a>
        <a
          href="https://github.com/sayliks/astro-paper"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent rounded-sm font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
        >
          前往 GitHub 仓库 &rarr;
        </a>
      </div>
    </section>

    <hr class="my-8 border-dashed" />

    <section aria-labelledby="cms-areas-title" class="space-y-4">
      <h2 id="cms-areas-title" class="text-lg font-semibold">内容范围</h2>
      <ul class="divide-border divide-y">
        {
          contentAreas.map(area => (
            <li class="grid gap-2 py-4 sm:grid-cols-[8rem_1fr]">
              <a
                href={area.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent rounded-sm font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
              >
                {area.label}
              </a>
              <div class="text-muted-foreground space-y-1 text-sm">
                <p>{area.description}</p>
                <p>
                  <code class="text-foreground rounded-sm bg-[var(--muted)] px-1.5 py-0.5 text-xs">
                    {area.path}
                  </code>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="my-8 border-dashed" />

    <section
      aria-labelledby="cms-guide-title"
      class="text-muted-foreground space-y-4 text-sm"
    >
      <h2 id="cms-guide-title" class="text-foreground text-lg font-semibold">
        使用说明
      </h2>
      <ol class="list-decimal space-y-2 pl-5">
        <li>线上使用时，请选择 GitHub OAuth 或令牌登录。</li>
        <li>账号需要拥有 sayliks/astro-paper 仓库的写入权限。</li>
        <li>没有仓库权限的账号可以打开 CMS 页面，但无法提交内容变更。</li>
        <li>新建或编辑内容后，保存并提交变更；草稿不会进入生产页面。</li>
        <li>本地测试时，也可以选择本地仓库并选中项目根目录。</li>
      </ol>

      <div>
        <h3 class="text-foreground font-semibold">中文化状态</h3>
        <p class="mt-2">
          本站 CMS 配置、字段标签、提示文字和授权提示已使用中文。Sveltia CMS
          的内置界面语言由浏览器自动决定；当前无法通过配置强制切换为中文。
        </p>
      </div>

      <p>
        <a
          href="https://sveltiacms.app/en/docs/ui"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
        >
          Sveltia CMS 界面文档
        </a>
      </p>
    </section>
  </main>

  <Footer />
</Layout>
