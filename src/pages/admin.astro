---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconEdit from "@/assets/icons/IconEdit.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import Main from "@/components/Main.astro";
import ResponsiveTable from "@/components/ResponsiveTable.astro";
import Layout from "@/layouts/Layout.astro";
import { getPostSlug } from "@/utils/getPostPaths";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

type PostEntry = CollectionEntry<"posts">;
type PostStatus = "Published" | "Draft" | "Scheduled";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const pages = await getCollection("pages");
const now = Date.now();

const getActivityTime = (post: PostEntry) =>
  new Date(post.data.modDatetime ?? post.data.pubDatetime).getTime();

const getPostStatus = (post: PostEntry): PostStatus => {
  if (post.data.draft) return "Draft";

  const publishAt = new Date(post.data.pubDatetime).getTime();
  if (publishAt > now + config.posts.scheduledPostMargin) {
    return "Scheduled";
  }

  return "Published";
};

const publishedPosts = posts.filter(
  post => getPostStatus(post) === "Published"
);
const draftPosts = posts.filter(post => getPostStatus(post) === "Draft");
const scheduledPosts = posts.filter(
  post => getPostStatus(post) === "Scheduled"
);
const featuredPosts = publishedPosts.filter(post => post.data.featured);
const publicTags = getUniqueTags(posts);
const postsWithoutExplicitOg = posts.filter(post => !post.data.ogImage);
const recentPosts = [...publishedPosts]
  .sort((a, b) => getActivityTime(b) - getActivityTime(a))
  .slice(0, 8);

const editorPosts = recentPosts.map(post => {
  const rawBody =
    "body" in post && typeof post.body === "string" ? post.body : "";

  return {
    id: getPostSlug(post.id, post.filePath).replace(/^\/+/, ""),
    title: post.data.title,
    slug: getPostSlug(post.id, post.filePath).replace(/^\/+/, ""),
    description: post.data.description,
    tags: post.data.tags,
    status: getPostStatus(post),
    format: "markdown",
    content: rawBody,
    pubDatetime: new Date(post.data.pubDatetime).toISOString().slice(0, 10),
  };
});

const editorPostsJson = JSON.stringify(editorPosts).replace(/</g, "\\u003c");

const statCards = [
  {
    label: "已发布",
    value: publishedPosts.length,
    detail: "公开文章",
  },
  {
    label: "草稿",
    value: draftPosts.length,
    detail: "私人记录",
  },
  {
    label: "已排期",
    value: scheduledPosts.length,
    detail: "待发布文章",
  },
  {
    label: "页面",
    value: pages.length,
    detail: "静态页面",
  },
];

const quickLinks = [
  {
    label: "文章",
    href: getRelativeLocaleUrl(locale, "posts"),
    icon: IconEdit,
  },
  {
    label: "标签",
    href: getRelativeLocaleUrl(locale, "tags"),
    icon: IconHash,
  },
  {
    label: "归档",
    href: getRelativeLocaleUrl(locale, "archives"),
    icon: IconArchive,
  },
  {
    label: "搜索",
    href: getRelativeLocaleUrl(locale, "search"),
    icon: IconSearch,
  },
  {
    label: "RSS",
    href: getRelativeLocaleUrl(locale, "rss.xml"),
    icon: IconRss,
  },
];

const siteSettings = [
  { label: "站点标题", value: config.site.title },
  { label: "作者", value: config.site.author },
  { label: "时区", value: config.site.timezone },
  {
    label: "搜索",
    value: config.features.search === "pagefind" ? "Pagefind" : "关闭",
  },
  {
    label: "动态 OG 图",
    value: config.features.dynamicOgImage ? "开启" : "关闭",
  },
  {
    label: "精选文章",
    value: String(featuredPosts.length),
  },
  {
    label: "公开标签",
    value: String(publicTags.length),
  },
  {
    label: "可生成 OG 图的文章",
    value: String(postsWithoutExplicitOg.length),
  },
];
---

<Layout
  title={`管理后台 | ${config.site.title}`}
  description={`${config.site.title} 的内容与站点状态概览`}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <Header />

  <Breadcrumb />

  <Main
    pageTitle="管理后台"
    pageDesc="内容状态、发布信息和站点设置概览。"
  >
    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        statCards.map(card => (
          <article class="border-border bg-background rounded-md border p-4">
            <p class="text-muted-foreground text-sm">{card.label}</p>
            <p class="mt-2 text-3xl font-semibold">{card.value}</p>
            <p class="text-muted-foreground mt-1 text-sm">{card.detail}</p>
          </article>
        ))
      }
    </section>

    <section
      id="article-editor"
      data-pagefind-ignore
      class="border-border mt-10 rounded-md border p-4"
    >
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold">文章编辑</h2>
          <p class="text-muted-foreground mt-1 text-sm">
            支持 Markdown 和 HTML 两种正文格式。
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            id="new-post-btn"
            type="button"
            class="border-border hover:border-accent rounded-md border px-3 py-2 text-sm"
          >
            新建文章
          </button>
          <button
            id="save-post-btn"
            type="button"
            class="bg-accent text-accent-foreground rounded-md px-3 py-2 text-sm"
          >
            保存
          </button>
          <button
            id="export-post-btn"
            type="button"
            class="border-border hover:border-accent rounded-md border px-3 py-2 text-sm"
          >
            导出
          </button>
        </div>
      </div>

      <form id="post-editor-form" class="grid gap-4 lg:grid-cols-2">
        <label class="grid gap-1">
          <span class="text-muted-foreground text-sm">标题</span>
          <input
            id="post-title"
            name="title"
            class="border-border bg-background focus:border-accent rounded-md border px-3 py-2"
            autocomplete="off"
          />
        </label>

        <label class="grid gap-1">
          <span class="text-muted-foreground text-sm">Slug</span>
          <input
            id="post-slug"
            name="slug"
            class="border-border bg-background focus:border-accent rounded-md border px-3 py-2"
            autocomplete="off"
          />
        </label>

        <label class="grid gap-1">
          <span class="text-muted-foreground text-sm">摘要</span>
          <textarea
            id="post-description"
            name="description"
            rows="3"
            class="border-border bg-background focus:border-accent resize-y rounded-md border px-3 py-2"
          ></textarea>
        </label>

        <div class="grid gap-4 sm:grid-cols-3">
          <label class="grid gap-1">
            <span class="text-muted-foreground text-sm">标签</span>
            <input
              id="post-tags"
              name="tags"
              class="border-border bg-background focus:border-accent rounded-md border px-3 py-2"
              autocomplete="off"
            />
          </label>

          <label class="grid gap-1">
            <span class="text-muted-foreground text-sm">发布日期</span>
            <input
              id="post-date"
              name="pubDatetime"
              type="date"
              class="border-border bg-background focus:border-accent rounded-md border px-3 py-2"
            />
          </label>

          <label class="grid gap-1">
            <span class="text-muted-foreground text-sm">状态</span>
            <select
              id="post-status"
              name="status"
              class="border-border bg-background focus:border-accent rounded-md border px-3 py-2"
            >
              <option value="Published">已发布</option>
              <option value="Draft">草稿</option>
              <option value="Scheduled">已排期</option>
            </select>
          </label>
        </div>

        <fieldset class="grid gap-2 lg:col-span-2">
          <legend class="text-muted-foreground text-sm">正文格式</legend>
          <div class="border-border inline-flex w-fit overflow-hidden rounded-md border">
            <label class="format-option">
              <input type="radio" name="format" value="markdown" checked />
              <span>Markdown</span>
            </label>
            <label class="format-option">
              <input type="radio" name="format" value="html" />
              <span>HTML</span>
            </label>
          </div>
        </fieldset>

        <label class="grid gap-1 lg:col-span-2">
          <span class="text-muted-foreground text-sm">正文</span>
          <textarea
            id="post-content"
            name="content"
            rows="16"
            class="border-border bg-background focus:border-accent min-h-80 resize-y rounded-md border px-3 py-2 font-mono text-sm"
          ></textarea>
        </label>
      </form>

      <p id="editor-message" class="text-muted-foreground mt-3 min-h-5 text-sm">
      </p>
    </section>

    <section class="mt-10 grid gap-8 lg:grid-cols-[1fr_17rem]">
      <div>
        <div class="mb-3 flex items-end justify-between gap-4">
          <h2 class="text-xl font-semibold">内容队列</h2>
          <span class="text-muted-foreground text-sm">
            共 <span id="queue-count">{publishedPosts.length}</span> 篇
          </span>
        </div>

        <ResponsiveTable
          variant="striped-minimal"
          class="border-border rounded-md border"
        >
          <table class="w-full text-left text-sm">
            <thead class="border-border border-b">
              <tr class="[&>th]:px-4 [&>th]:py-3 [&>th]:font-medium">
                <th scope="col">文章</th>
                <th scope="col">状态</th>
                <th scope="col">格式</th>
                <th scope="col">日期</th>
                <th scope="col">操作</th>
              </tr>
            </thead>
            <tbody id="content-queue"></tbody>
          </table>
        </ResponsiveTable>
      </div>

      <aside class="space-y-8">
        <section>
          <h2 class="mb-3 text-xl font-semibold">快捷入口</h2>
          <div class="grid gap-2">
            {
              quickLinks.map(({ label, href, icon: Icon }) => (
                <LinkButton
                  href={href}
                  class="border-border hover:border-accent rounded-md border px-3 py-2"
                >
                  <Icon class="size-5" />
                  <span>{label}</span>
                  <IconArrowRight class="ms-auto size-4" />
                </LinkButton>
              ))
            }
          </div>
        </section>

        <section>
          <h2 class="mb-3 text-xl font-semibold">站点设置</h2>
          <dl class="border-border rounded-md border">
            {
              siteSettings.map(item => (
                <div class="border-border flex items-start justify-between gap-4 border-b px-3 py-2 last:border-0">
                  <dt class="text-muted-foreground text-sm">{item.label}</dt>
                  <dd class="max-w-36 text-right text-sm font-medium break-words">
                    {item.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>
      </aside>
    </section>
  </Main>

  <script
    id="admin-posts-data"
    type="application/json"
    is:inline
    set:html={editorPostsJson}
  />

  <script is:inline>
    const storageKey = "sayliks-admin-posts";
    const sourcePosts = JSON.parse(
      document.querySelector("#admin-posts-data")?.textContent || "[]"
    ).map(post => ({ ...post, source: "site" }));

    const els = {
      queue: document.querySelector("#content-queue"),
      count: document.querySelector("#queue-count"),
      form: document.querySelector("#post-editor-form"),
      title: document.querySelector("#post-title"),
      slug: document.querySelector("#post-slug"),
      description: document.querySelector("#post-description"),
      tags: document.querySelector("#post-tags"),
      date: document.querySelector("#post-date"),
      status: document.querySelector("#post-status"),
      content: document.querySelector("#post-content"),
      message: document.querySelector("#editor-message"),
      newPost: document.querySelector("#new-post-btn"),
      savePost: document.querySelector("#save-post-btn"),
      exportPost: document.querySelector("#export-post-btn"),
    };

    const statusLabels = {
      Published: "已发布",
      Draft: "草稿",
      Scheduled: "已排期",
    };

    const statusClasses = {
      Published:
        "border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300",
      Draft:
        "border-muted bg-muted/60 text-muted-foreground dark:border-muted-foreground/30",
      Scheduled: "border-accent/40 bg-accent/10 text-accent",
    };

    const escapeHtml = value =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const slugify = value => {
      const slug = String(value || "")
        .trim()
        .toLowerCase()
        .replace(/[^\p{Letter}\p{Number}]+/gu, "-")
        .replace(/^-+|-+$/g, "");
      return slug || `post-${Date.now()}`;
    };

    const today = () => new Date().toISOString().slice(0, 10);

    const readLocalPosts = () => {
      try {
        const parsed = JSON.parse(localStorage.getItem(storageKey) || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    let localPosts = readLocalPosts();
    let activePostId = "";
    let slugTouched = false;

    const writeLocalPosts = () => {
      localStorage.setItem(storageKey, JSON.stringify(localPosts));
    };

    const mergedPosts = () => {
      const posts = new Map();
      for (const post of sourcePosts) posts.set(post.id, post);
      for (const post of localPosts) posts.set(post.id, post);
      return [...posts.values()].sort((a, b) =>
        String(b.pubDatetime || "").localeCompare(String(a.pubDatetime || ""))
      );
    };

    const setMessage = message => {
      if (els.message) els.message.textContent = message;
    };

    const getFormat = () =>
      els.form?.querySelector("input[name='format']:checked")?.value ||
      "markdown";

    const setFormat = format => {
      const input = els.form?.querySelector(
        `input[name='format'][value='${format}']`
      );
      if (input) input.checked = true;
    };

    const emptyPost = () => ({
      id: `local-${Date.now()}`,
      title: "",
      slug: "",
      description: "",
      tags: ["随笔"],
      status: "Draft",
      format: "markdown",
      content: "",
      pubDatetime: today(),
      source: "browser",
    });

    const setForm = post => {
      activePostId = post.id;
      slugTouched = Boolean(post.slug);
      els.title.value = post.title || "";
      els.slug.value = post.slug || "";
      els.description.value = post.description || "";
      els.tags.value = (post.tags || []).join("，");
      els.date.value = post.pubDatetime || today();
      els.status.value = post.status || "Draft";
      els.content.value = post.content || "";
      setFormat(post.format || "markdown");
      setMessage("");
    };

    const collectForm = () => {
      const title = els.title.value.trim();
      const slug = slugify(els.slug.value || title);
      const tags = els.tags.value
        .split(/[，,]/)
        .map(tag => tag.trim())
        .filter(Boolean);

      return {
        id: activePostId || `local-${Date.now()}`,
        title,
        slug,
        description: els.description.value.trim(),
        tags: tags.length > 0 ? tags : ["随笔"],
        status: els.status.value,
        format: getFormat(),
        content: els.content.value,
        pubDatetime: els.date.value || today(),
        source: "browser",
      };
    };

    const frontmatter = post => {
      const tags = post.tags.map(tag => `  - ${tag}`).join("\n");
      return [
        "---",
        `title: ${JSON.stringify(post.title)}`,
        `pubDatetime: ${post.pubDatetime}T00:00:00+08:00`,
        `draft: ${post.status !== "Published"}`,
        "tags:",
        tags,
        `description: ${JSON.stringify(post.description)}`,
        "---",
        "",
      ].join("\n");
    };

    const exportMarkdown = post => `${frontmatter(post)}${post.content}\n`;

    const exportHtml = post => `<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>${escapeHtml(post.title)}</title>
    <meta name="description" content="${escapeHtml(post.description)}" />
  </head>
  <body>
    <article>
${post.content}
    </article>
  </body>
</html>
`;

    const downloadFile = (name, content, type) => {
      const blob = new Blob([content], { type });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = name;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    };

    const saveCurrentPost = () => {
      const post = collectForm();
      if (!post.title) {
        setMessage("请先填写标题。");
        els.title.focus();
        return null;
      }

      post.id = post.slug;
      activePostId = post.id;
      localPosts = [
        ...localPosts.filter(item => item.id !== post.id),
        post,
      ];
      writeLocalPosts();
      renderQueue();
      setMessage("已保存到浏览器。");
      return post;
    };

    const exportCurrentPost = () => {
      const post = collectForm();
      if (!post.title) {
        setMessage("请先填写标题。");
        els.title.focus();
        return;
      }

      if (post.format === "html") {
        downloadFile(
          `${post.slug}.html`,
          exportHtml(post),
          "text/html;charset=utf-8"
        );
        setMessage("HTML 文件已导出。");
        return;
      }

      downloadFile(
        `${post.slug}.md`,
        exportMarkdown(post),
        "text/markdown;charset=utf-8"
      );
      setMessage("Markdown 文件已导出。");
    };

    const renderQueue = () => {
      const posts = mergedPosts();
      if (els.count) els.count.textContent = String(posts.length);
      if (!els.queue) return;

      els.queue.innerHTML = posts
        .map(post => {
          const formatLabel =
            post.format === "html" ? "HTML" : "Markdown";
          return `
            <tr class="border-border border-b last:border-0 [&>td]:px-4 [&>td]:py-3">
              <td>
                <span class="text-accent">${escapeHtml(post.title || "未命名文章")}</span>
                <p class="text-muted-foreground mt-1 line-clamp-1">
                  ${escapeHtml((post.tags || []).join("，"))}
                </p>
              </td>
              <td>
                <span class="inline-flex rounded px-2 py-1 text-xs font-medium border ${statusClasses[post.status] || statusClasses.Draft}">
                  ${statusLabels[post.status] || "草稿"}
                </span>
              </td>
              <td class="text-muted-foreground whitespace-nowrap">${formatLabel}</td>
              <td class="text-muted-foreground whitespace-nowrap">${escapeHtml(post.pubDatetime || "-")}</td>
              <td>
                <button
                  type="button"
                  data-edit-post="${escapeHtml(post.id)}"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  编辑
                </button>
              </td>
            </tr>
          `;
        })
        .join("");
    };

    els.title?.addEventListener("input", () => {
      if (!slugTouched) els.slug.value = slugify(els.title.value);
    });

    els.slug?.addEventListener("input", () => {
      slugTouched = true;
    });

    els.newPost?.addEventListener("click", () => {
      setForm(emptyPost());
      setMessage("正在新建文章。");
      els.title.focus();
    });

    els.savePost?.addEventListener("click", saveCurrentPost);
    els.exportPost?.addEventListener("click", exportCurrentPost);

    els.queue?.addEventListener("click", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("[data-edit-post]");
      if (!button) return;

      const post = mergedPosts().find(item => item.id === button.dataset.editPost);
      if (!post) return;

      setForm(post);
      document.querySelector("#article-editor")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });

    renderQueue();
    setForm(mergedPosts()[0] || emptyPost());
  </script>

  <style>
    .format-option {
      cursor: pointer;
    }

    .format-option input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .format-option span {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }

    .format-option input:checked + span {
      background: var(--accent);
      color: var(--accent-foreground);
    }

    .format-option input:focus-visible + span {
      outline: 2px dashed var(--accent);
      outline-offset: -3px;
    }
  </style>

  <Footer />
</Layout>
